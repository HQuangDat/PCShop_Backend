# Copy this file to .env and fill in values before running docker compose up

# SQL Server SA password — must meet complexity: uppercase, lowercase, digit, symbol, min 8 chars
SA_PASSWORD=YourStr0ng!Password

# JWT — generate a random 32+ character string
JWT_KEY=your_super_secret_jwt_key_that_is_at_least_32_characters
JWT_ISSUER=pcshop
JWT_AUDIENCE=pcshop_users
JWT_EXPIRE_MINUTES=60

# Hangfire dashboard credentials
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=admin123

# Ports (change if defaults conflict with local services)
API_PORT=8080
SQL_PORT=1433
REDIS_PORT=6379

# SMTP (leave blank to disable email features)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER_EMAIL=your@email.com
SMTP_SENDER_NAME=PCShop
